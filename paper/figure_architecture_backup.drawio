<mxfile host="app.diagrams.net" modified="2026-06-15T00:00:00.000Z" agent="gpt-5.4" version="24.7.17">
  <diagram id="neurips-pipeline" name="NeurIPS Pipeline">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;font style=&quot;font-size:22px;&quot;&gt;&lt;b&gt;Self-Play Multi-Hop QA Training Pipeline&lt;/b&gt;&lt;/font&gt;"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;"
          vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="760" height="40" as="geometry"/>
        </mxCell>

        <!-- Seed Data -->
        <mxCell id="seed" value="&lt;b&gt;Seed QA Data&lt;/b&gt;&lt;br&gt;NQ, TriviaQA, PopQA,&lt;br&gt;HotpotQA, 2WikiMultiHopQA, MuSiQue"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F7E8EE;strokeColor=#C9A7B5;fontColor=#2B2B2B;strokeWidth=1.6;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="220" height="88" as="geometry"/>
        </mxCell>

        <!-- Retrieval backend -->
        <mxCell id="wiki" value="&lt;b&gt;Shared Wikipedia Retrieval&lt;/b&gt;&lt;br&gt;FAISS index&lt;br&gt;E5-base-v2&lt;br&gt;top-3 passages"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF4EC;strokeColor=#9DB9A3;fontColor=#2B2B2B;strokeWidth=1.6;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="220" height="96" as="geometry"/>
        </mxCell>

        <!-- Note -->
        <mxCell id="note" value="&lt;b&gt;Multi-hop question&lt;/b&gt;&lt;br&gt;n-hop requires n−1 chained searches.&lt;br&gt;Example: A → B → C.&lt;br&gt;Question mentions only A and asks for C."
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8F2DF;strokeColor=#CBB98C;fontColor=#2B2B2B;strokeWidth=1.4;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="220" height="104" as="geometry"/>
        </mxCell>

        <!-- Outer iteration group -->
        <mxCell id="iter" value="3-Iteration Self-Play Loop"
          style="rounded=1;whiteSpace=wrap;html=1;container=1;recursiveResize=0;arcSize=14;fillColor=#F4F1FB;strokeColor=#B7A9D6;fontColor=#3A3350;strokeWidth=1.8;"
          vertex="1" parent="1">
          <mxGeometry x="330" y="90" width="1380" height="760" as="geometry"/>
        </mxCell>

        <!-- Iter subtitle -->
        <mxCell id="iter_sub" value="All three models are Qwen2.5-3B. Checkpoints are carried to the next iteration."
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4B4560;"
          vertex="1" parent="iter">
          <mxGeometry x="24" y="16" width="700" height="24" as="geometry"/>
        </mxCell>

        <!-- Init -->
        <mxCell id="init" value="&lt;b&gt;Initialize from previous iteration&lt;/b&gt;&lt;br&gt;Challenger / Solver / Verifier checkpoints"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBF5DD;strokeColor=#CDBB84;fontColor=#2B2B2B;strokeWidth=1.5;"
          vertex="1" parent="iter">
          <mxGeometry x="30" y="58" width="280" height="70" as="geometry"/>
        </mxCell>

        <!-- Three models row -->
        <mxCell id="challenger" value="&lt;b&gt;Challenger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Input: Wikipedia document&lt;br&gt;Output: multi-hop question&lt;br&gt;Hop ratio: 4:3:2:1 (4-hop most frequent)&lt;br&gt;Training: GRPO-Batch&lt;br&gt;Reward ↑ when Solver fails&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF1FB;strokeColor=#9CB3D1;fontColor=#2B2B2B;strokeWidth=1.6;"
          vertex="1" parent="iter">
          <mxGeometry x="40" y="180" width="330" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="solver" value="&lt;b&gt;Solver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Input: generated multi-hop question&lt;br&gt;Loop: &amp;lt;think&amp;gt; → &amp;lt;tool_call&amp;gt; → &amp;lt;tool_response&amp;gt;&lt;br&gt;repeated as needed&lt;br&gt;Training: GRPO (group=5)&lt;br&gt;Reward: Verifier judgment + exact match&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF1FB;strokeColor=#9CB3D1;fontColor=#2B2B2B;strokeWidth=1.6;"
          vertex="1" parent="iter">
          <mxGeometry x="510" y="180" width="340" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="verifier" value="&lt;b&gt;Verifier&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Input: question + predicted answer&lt;br&gt;Backward search verification from candidate answer&lt;br&gt;Output: &amp;lt;answer&amp;gt;yes&amp;lt;/answer&amp;gt; / &amp;lt;answer&amp;gt;no&amp;lt;/answer&amp;gt;&lt;br&gt;Training: GRPO (group=5)&lt;br&gt;Reward: accuracy vs labels&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF1FB;strokeColor=#9CB3D1;fontColor=#2B2B2B;strokeWidth=1.6;"
          vertex="1" parent="iter">
          <mxGeometry x="990" y="180" width="340" height="180" as="geometry"/>
        </mxCell>

        <!-- Data/process row -->
        <mxCell id="qgen" value="&lt;b&gt;Question Generation&lt;/b&gt;&lt;br&gt;~50k questions / iteration"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F7E8EE;strokeColor=#C9A7B5;fontColor=#2B2B2B;strokeWidth=1.5;"
          vertex="1" parent="iter">
          <mxGeometry x="95" y="450" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="solver_train" value="&lt;b&gt;Solver Training&lt;/b&gt;&lt;br&gt;Generated questions become training data"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBF5DD;strokeColor=#CDBB84;fontColor=#2B2B2B;strokeWidth=1.5;"
          vertex="1" parent="iter">
          <mxGeometry x="560" y="440" width="240" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="infer" value="&lt;b&gt;Solver Inference&lt;/b&gt;&lt;br&gt;Sampled subset: 12,800 questions"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F7E8EE;strokeColor=#C9A7B5;fontColor=#2B2B2B;strokeWidth=1.5;"
          vertex="1" parent="iter">
          <mxGeometry x="560" y="560" width="240" height="72" as="geometry"/>
        </mxCell>

        <mxCell id="vdata" value="&lt;b&gt;Verifier Training Data&lt;/b&gt;&lt;br&gt;Positive/negative pairs from Solver predictions&lt;br&gt;(both correct and incorrect)"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F7E8EE;strokeColor=#C9A7B5;fontColor=#2B2B2B;strokeWidth=1.5;"
          vertex="1" parent="iter">
          <mxGeometry x="1040" y="450" width="250" height="86" as="geometry"/>
        </mxCell>

        <mxCell id="carry" value="&lt;b&gt;Carry checkpoints to next iteration&lt;/b&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBF5DD;strokeColor=#CDBB84;fontColor=#2B2B2B;strokeWidth=1.5;"
          vertex="1" parent="iter">
          <mxGeometry x="560" y="690" width="240" height="64" as="geometry"/>
        </mxCell>

        <!-- Edges from left context -->
        <mxCell id="e1" value=""
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.8;strokeColor=#8E8E8E;endArrow=block;endFill=1;"
          edge="1" parent="1" source="seed" target="init">
